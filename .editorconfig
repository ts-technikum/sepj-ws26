# Einheitliche Formatierung für alle Teammitglieder und Editoren.
# Ohne diese Datei formatiert jeder anders, und die Pull Requests zeigen
# Änderungen, die keine sind.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
