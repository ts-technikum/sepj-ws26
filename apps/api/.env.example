# Vorlage: nach apps/api/.env kopieren und ausfüllen.
# apps/api/.env steht in .gitignore und wird NIE committet.

# mock = feste Antworten ohne Netz (Standard), anthropic = echtes Modell
LLM_PROVIDER=anthropic

# Schlüssel aus https://console.anthropic.com (beginnt mit sk-ant-)
ANTHROPIC_API_KEY=

# low | medium | high
LLM_EFFORT=medium
